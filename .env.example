# Required: bot token from @BotFather
BOT_TOKEN=123456:replace-me
# Required: Telegram user IDs allowed to use the bot, comma-separated (get yours from @userinfobot)
ALLOWED_USER_IDS=111111111,222222222

# Optional overrides (defaults shown)
# DB_PATH=energy_bot.db
# TIMEZONE=Europe/Kyiv
# SCHEDULE_POLL_SECONDS=300
# ACCIDENT_POLL_SECONDS=180
# WARNING_TICK_SECONDS=60
# WARNING_OFFSETS_MINUTES=60,30
# How late a missed warning may still be sent (e.g. after a restart). Keep it smaller than the gap
# between warning offsets (60 and 30 -> under 30), or both warnings may be sent at once.
# WARNING_CATCHUP_MINUTES=10
# DEFAULT_QUIET_START=23:00
# DEFAULT_QUIET_END=07:00
# LOG_LEVEL=INFO
# Optional "ok" web endpoint, needed when the host runs the bot as a website (alwaysdata "User program").
# Leave HEALTH_PORT unset to run without it.
# HEALTH_PORT=8100
# HEALTH_HOST=0.0.0.0
